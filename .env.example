# Copy to .env and fill in. Never commit .env.

APP_ENV=development
HTTP_PORT=8080

# Shared local Postgres (atmosfera-postgres). The search_path is the project's schema.
#   Local:      postgresql://messaging_app:<password>@localhost:5432/messaging?search_path=messaging
#   Production: postgresql://messaging_app:<password>@atm-postgres:5432/messaging?search_path=messaging
# This database also holds customers' WhatsApp credentials (whatsmeow_* tables).
DATABASE_URL=

# Sending limits per session. Starting points to tune, NOT official WhatsApp figures.
# Durations accept Go syntax: 500ms, 8s, 5m, 1h.
# LIMITS_TIMEZONE=America/Lima                 # when a "day" starts for the daily caps
# LIMITS_TRANSACTIONAL_INTERVAL=1s             # minimum gap between transactional messages
# LIMITS_TRANSACTIONAL_DAILY_CAP=2000
# LIMITS_PROMOTIONAL_MIN_DELAY=8s              # random gap between promotional messages
# LIMITS_PROMOTIONAL_MAX_DELAY=20s
# LIMITS_PROMOTIONAL_DAILY_CAP=200             # full cap, reached after the warm-up
# LIMITS_WARMUP_DAYS=7                         # days for a new number to reach the full cap

# Queue and retries.
# QUEUE_MAX_ATTEMPTS=3                         # failed sends before a message fails for good
# QUEUE_RETRY_BASE=30s                         # wait after the first failure; doubles each retry
# QUEUE_NOT_CONNECTED_RETRY=30s                # recheck period while a session is offline
# QUEUE_MAX_AGE=1h                             # a queued message older than this expires

# Outgoing webhooks. Events are queued in the database and retried with backoff
# (WEBHOOK_RETRY_BASE, x4 each time: 30s, 2m, 8m, ...).
# WEBHOOK_TIMEOUT=10s
# WEBHOOK_RETRY_BASE=30s
# WEBHOOK_MAX_ATTEMPTS=6
# Allow webhooks to reach private/loopback addresses and plain http. Defaults to
# true only when APP_ENV=development. Keep it OFF in production (SSRF protection).
# WEBHOOK_ALLOW_PRIVATE=false

# Administration API (/admin/v1) for the panel. There is a single operator; the API
# stays off until both are set. Use a long random password (min 12 chars), e.g.
#   openssl rand -base64 24
ADMIN_USER=
ADMIN_PASSWORD=
# ADMIN_SESSION_TTL=12h

# The web app (panel + public connect page).
# PUBLIC_WEB_URL is where it is served; connect links are built on it.
# WEB_CORS_ORIGINS lists the browser origins allowed to call /admin/v1 and /public.
PUBLIC_WEB_URL=http://localhost:5173
WEB_CORS_ORIGINS=http://localhost:5173
# How long a link for a customer to scan a QR stays valid.
# CONNECT_LINK_TTL=24h

# Reverse proxies whose X-Forwarded-For is trusted (login throttling uses the client IP).
# Leave empty unless the API runs behind a proxy.
# HTTP_TRUSTED_PROXIES=

# Template of /opt/messaging-api/.env on the server. Copy it there and fill in the
# values. It is never committed with real values and the deploy does not touch it.
# Create it with:  install -m 600 -o deploy -g deploy /dev/null /opt/messaging-api/.env

APP_ENV=production

# Host = container name of the shared PostgreSQL, on the network atm-network.
DATABASE_URL=postgresql://messaging_app:<DB_PASSWORD>@atm-postgres:5432/messaging?search_path=messaging

# Single operator of the web panel. There are no rules for the password.
ADMIN_USER=<user>
ADMIN_PASSWORD=<password>

# The web app (connect links are built on it) and the browser origin allowed by CORS.
PUBLIC_WEB_URL=https://messaging.atmosferast.com
WEB_CORS_ORIGINS=https://messaging.atmosferast.com

# The API sits behind the host nginx (which gets the real visitor IP from Cloudflare).
# Trust that hop so the login throttling sees the visitor, not the proxy. It is the
# gateway of the docker network atm-network.
HTTP_TRUSTED_PROXIES=172.21.0.0/16

# Optional tuning (defaults shown). Limits are starting points, not official WhatsApp figures.
# LIMITS_TIMEZONE=America/Lima
# LIMITS_TRANSACTIONAL_INTERVAL=1s
# LIMITS_TRANSACTIONAL_DAILY_CAP=2000
# LIMITS_PROMOTIONAL_MIN_DELAY=8s
# LIMITS_PROMOTIONAL_MAX_DELAY=20s
# LIMITS_PROMOTIONAL_DAILY_CAP=200
# LIMITS_WARMUP_DAYS=7
# QUEUE_MAX_ATTEMPTS=3
# QUEUE_MAX_AGE=1h
# CONNECT_LINK_TTL=24h
# ADMIN_SESSION_TTL=12h
